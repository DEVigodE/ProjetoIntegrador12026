{
  "realm": "logdash",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrador — acesso total ao sistema"
      },
      {
        "name": "OPERATOR",
        "description": "Operador — gerencia produtos e pedidos"
      },
      {
        "name": "DISPATCHER",
        "description": "Despachante — gerencia entregas e entregadores"
      },
      {
        "name": "CLIENT",
        "description": "Cliente — usuário final"
      },
      {
        "name": "COURIER",
        "description": "Entregador — acessa entregas atribuídas e envia localização"
      }
    ]
  },
  "clients": [
    {
      "clientId": "logdash-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "logdash-webapp",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*",
        "http://localhost:3000/*",
        "http://localhost:8081/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@logdash.dev",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "operador",
      "enabled": true,
      "emailVerified": true,
      "email": "operador@logdash.dev",
      "firstName": "Operador",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "operador123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPERATOR"
      ]
    },
    {
      "username": "despachante",
      "enabled": true,
      "emailVerified": true,
      "email": "despachante@logdash.dev",
      "firstName": "Despachante",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "despachante123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DISPATCHER"
      ]
    },
    {
      "username": "cliente",
      "enabled": true,
      "emailVerified": true,
      "email": "cliente@logdash.dev",
      "firstName": "Cliente",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "cliente123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CLIENT"
      ]
    },
    {
      "username": "entregador",
      "enabled": true,
      "emailVerified": true,
      "email": "entregador@logdash.dev",
      "firstName": "Entregador",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "entregador123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "COURIER"
      ]
    }
  ]
}