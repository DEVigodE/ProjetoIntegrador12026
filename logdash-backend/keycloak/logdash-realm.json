{
  "realm": "logdash",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Administrador — acesso total ao sistema" },
      { "name": "OPERATOR", "description": "Operador — gerencia produtos e pedidos" },
      { "name": "DISPATCHER", "description": "Despachante — gerencia entregas e entregadores" }
    ]
  },
  "clients": [
    {
      "clientId": "logdash-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "logdash-webapp",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*",
        "http://localhost:3000/*",
        "http://localhost:8081/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@logdash.dev",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "operador",
      "enabled": true,
      "emailVerified": true,
      "email": "operador@logdash.dev",
      "firstName": "Operador",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "operador123",
          "temporary": false
        }
      ],
      "realmRoles": ["OPERATOR"]
    },
    {
      "username": "despachante",
      "enabled": true,
      "emailVerified": true,
      "email": "despachante@logdash.dev",
      "firstName": "Despachante",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "despachante123",
          "temporary": false
        }
      ],
      "realmRoles": ["DISPATCHER"]
    }
  ]
}
